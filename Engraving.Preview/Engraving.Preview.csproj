<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line previewer: renders .eng scripts to PNG without starting Valheim. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engraving.Core\Engraving.Core.csproj" />
  </ItemGroup>
</Project>
